---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import type { Lang } from '@/types/post';
import { siteConfig } from '@/config/site';
import { getPortfolioPaths, type PortfolioEntry } from '@/lib/portfolio';
import { messages } from '@/i18n/locales';
import { routePaths } from '@/lib/routes';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/markdown.css';

// 作品集详情页：每个 mdx 文件对应一个 (lang, slug) 静态路由，正文用 render() 渲染
export const getStaticPaths: GetStaticPaths = () => getPortfolioPaths();

type Props = { entry: PortfolioEntry };

const lang = Astro.params.lang as Lang;
const t = messages[lang];
const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const { title, summary, techStack } = entry.data;
---

<BaseLayout
  lang={lang}
  title={`${title} · ${t.portfolio.title} · ${siteConfig.name[lang]}`}
  description={summary}
  indexable
>
  <article
    class="container container--prose portfolio-detail"
    data-pagefind-body
    data-pagefind-filter={`lang:${lang}`}
  >
    <a class="portfolio-detail__back" href={routePaths.portfolio(lang)}>
      ← {t.portfolio.back}
    </a>

    <header class="portfolio-detail__header">
      <h1 data-pagefind-meta="title">{title}</h1>
      <p data-pagefind-meta="summary">{summary}</p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <section class="portfolio-detail__tech">
      <h2>{t.portfolio.techStack}</h2>
      <ul class="portfolio-detail__tags">
        {techStack.map((tech) => <li>{tech}</li>)}
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .portfolio-detail {
    padding-top: var(--sp-8);
    padding-bottom: var(--sp-10);
  }

  .portfolio-detail__back {
    display: inline-block;
    margin-bottom: var(--sp-5);
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
  }

  .portfolio-detail__header {
    padding-bottom: var(--sp-5);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--sp-6);
  }

  .portfolio-detail__header h1 {
    font-size: var(--fs-3xl);
    margin: 0 0 var(--sp-3);
  }

  .portfolio-detail__header p {
    color: var(--color-fg-muted);
    font-size: var(--fs-lg);
    margin: 0;
  }

  .portfolio-detail__tech {
    margin-top: var(--sp-6);
  }

  .portfolio-detail__tech h2 {
    font-size: var(--fs-xl);
    margin: 0 0 var(--sp-3);
  }

  .portfolio-detail__tags {
    list-style: none;
    padding-left: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .portfolio-detail__tags li {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg-subtle);
    font-size: var(--fs-xs);
  }
</style>
