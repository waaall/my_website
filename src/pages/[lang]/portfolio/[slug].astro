---
import type { GetStaticPaths } from 'astro';
import type { Lang } from '@/types/post';
import { siteConfig } from '@/config/site';
import { getPortfolioPaths, type PortfolioItem } from '@/config/portfolio';
import { messages } from '@/i18n/locales';
import { routePaths } from '@/lib/routes';
import BaseLayout from '@/layouts/BaseLayout.astro';

// 作品集详情页：静态生成每个语言下的三类作品方向
export const getStaticPaths: GetStaticPaths = () => getPortfolioPaths(siteConfig.supportedLangs);

type Props = {
  item: PortfolioItem;
};

const lang = Astro.params.lang as Lang;
const t = messages[lang];
const { item } = Astro.props as Props;
---

<BaseLayout
  lang={lang}
  title={`${item.title[lang]} · ${t.portfolio.title} · ${siteConfig.name[lang]}`}
  description={item.summary[lang]}
  indexable
>
  <article
    class="container container--prose portfolio-detail"
    data-pagefind-body
    data-pagefind-filter={`lang:${lang}`}
  >
    <a class="portfolio-detail__back" href={routePaths.portfolio(lang)}>
      ← {t.portfolio.back}
    </a>

    <header class="portfolio-detail__header">
      <h1 data-pagefind-meta="title">{item.title[lang]}</h1>
      <p data-pagefind-meta="summary">{item.summary[lang]}</p>
    </header>

    <section class="portfolio-detail__section">
      <h2>{t.portfolio.overview}</h2>
      <p>{item.overview[lang]}</p>
    </section>

    <section class="portfolio-detail__section">
      <h2>{t.portfolio.myWork}</h2>
      <ul>
        {item.work[lang].map((work) => <li>{work}</li>)}
      </ul>
    </section>

    <section class="portfolio-detail__section">
      <h2>{t.portfolio.techStack}</h2>
      <ul class="portfolio-detail__tags">
        {item.techStack.map((tech) => <li>{tech}</li>)}
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .portfolio-detail {
    padding-top: var(--sp-8);
    padding-bottom: var(--sp-10);
  }

  .portfolio-detail__back {
    display: inline-block;
    margin-bottom: var(--sp-5);
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
  }

  .portfolio-detail__header {
    padding-bottom: var(--sp-5);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--sp-6);
  }

  .portfolio-detail__header h1 {
    font-size: var(--fs-3xl);
    margin: 0 0 var(--sp-3);
  }

  .portfolio-detail__header p {
    color: var(--color-fg-muted);
    font-size: var(--fs-lg);
    margin: 0;
  }

  .portfolio-detail__section {
    margin-top: var(--sp-6);
  }

  .portfolio-detail__section h2 {
    font-size: var(--fs-xl);
    margin: 0 0 var(--sp-3);
  }

  .portfolio-detail__section p,
  .portfolio-detail__section li {
    color: var(--color-fg-muted);
  }

  .portfolio-detail__section ul {
    padding-left: var(--sp-5);
    margin: 0;
  }

  .portfolio-detail__section li + li {
    margin-top: var(--sp-2);
  }

  .portfolio-detail__tags {
    list-style: none;
    padding-left: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .portfolio-detail__tags li {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg-subtle);
    font-size: var(--fs-xs);
  }
</style>
